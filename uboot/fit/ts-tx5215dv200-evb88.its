/*
 * Simple U-Boot uImage source file containing a single kernel and FDT blob
 */

/dts-v1/;

/ {
	description = "Simple image with Linux kernel and FDT blob";
	#address-cells = <1>;

	images {
		kernel {
			description = "Tsingmicro Linux kernel";
			data = /incbin/("./zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x01008000>;
			entry = <0x01008000>;
/*			hash-1 {
				algo = "crc32";
			};
*/
		};
		tx5215dv200-evb88 {
			description = "Flattened Device Tree blob";
			data = /incbin/("./ts-tx5215dv200-evb88.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			load = <0x01000000>;
/*
			hash-1 {
				algo = "crc32";
			};
*/
		};
	};

	configurations {
		default = "fdt0";
		fdt0 {
			description = "Boot Linux kernel with FDT blob";
			kernel = "kernel";
			fdt = "tx5215dv200-evb88";
		};
	};
};
