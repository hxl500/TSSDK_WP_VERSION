################################ Cross Build Baremental Process ###############################

function cross_build_baremental()
{
    export COMPILER_GCC=${CROSS_COMPILER_PATH}/bin/arm-none-eabi-gcc
    export COMPILER_GXX=${CROSS_COMPILER_PATH}/bin/arm-none-eabi-g++
    export BOOTGEN=${BOOTGEN_PATH}/bootgen

    export CC=${COMPILER_GCC}
    export CXX=${COMPILER_GXX}

    ### Build bins and libraries
    echo "### Build bins and libraries--- Start ###"

    cd ${ARMCB_TEMP_DIR}
    cmake .
    assert $?

    sed -i "s/-rdynamic //g" `grep "rdynamic " -rl main/`

    make -j8
    assert $?

    make install
    assert $?

    mkdir -p ${ARMCB_TEMP_DIR}/main
    cp -rf ${ARMCB_SRC_DIR}/main.c          ${ARMCB_TEMP_DIR}/main/
    cp -rf ${ARMCB_SRC_DIR}/CMakeLists.txt  ${ARMCB_TEMP_DIR}/main/
    cp -rf ${ARMCB_TEMP_DIR}/common.cmake   ${ARMCB_TEMP_DIR}/main/
    cp -rf ${ARMCB_TEMP_DIR}/env.cmake      ${ARMCB_TEMP_DIR}/main/
    cd ${ARMCB_TEMP_DIR}/main/

    sed -i '1iinclude(common.cmake)' ${ARMCB_TEMP_DIR}/main/CMakeLists.txt
    sed -i '1iproject("isp")' ${ARMCB_TEMP_DIR}/main/CMakeLists.txt
    sed -i '1icmake_minimum_required(VERSION 2.8.5)' ${ARMCB_TEMP_DIR}/main/CMakeLists.txt
    sed -i '1iset(CMAKE_CXX_COMPILER_WORKS 1)' ${ARMCB_TEMP_DIR}/main/CMakeLists.txt
    sed -i '1iset(CMAKE_C_COMPILER_WORKS 1)' ${ARMCB_TEMP_DIR}/main/CMakeLists.txt

    cmake .
    assert $?

    sed -i "s/-rdynamic //g" `grep "rdynamic " -rl CMakeFiles/`

    make -j8
    assert $?

    ### Generate the BOOT.bin
    cd ${ARMCB_OUTPUT_DIR}
    echo "//arch = zynq; split = false; format = BIN"               >    ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif
    echo "the_ROM_image:"                                           >>   ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif
    echo "{"                                                        >>   ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif
    echo "    [bootloader]`find ${ARMCB_LIB_DIR} -name "*.elf"`"    >>   ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif
    echo "    `find ${ARMCB_LIB_DIR} -name "*.bit"`"                >>   ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif
    echo "    `find ${ARMCB_OUTPUT_DIR}/usr/bin -name "*.elf"`"     >>   ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif
    echo "}"                                                        >>   ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif

    ${BOOTGEN} -image isp_firmware_x.bif -arch zynq -o ${ARMCB_OUTPUT_DIR}/usr/bin/BOOT.bin

    rm -rf ${ARMCB_OUTPUT_DIR}/isp_firmware_x.bif
}

##################################### Launch Build Process ####################################

function build_process()
{

    if [ ${CROSS_BUILD} -eq 0 ]; then

        normal_build

    elif [ ${CROSS_BUILD} -eq 1 ]; then

        cross_build_linux

    elif [ ${CROSS_BUILD} -eq 2 ]; then

        cross_build_baremental

    fi
}

