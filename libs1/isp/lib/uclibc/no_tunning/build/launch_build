#!/bin/bash

###############################################################################################
#################################### Default Build Options ####################################
###############################################################################################

source ${TARGET_BUILD_DIR}/scripts/common_set.sh

# Disable cross build
#      CROSS_BUILD=10    ,  PC_LINUX
#      CROSS_BUILD=11    ,  EMBEDDED_LINUX
#      CROSS_BUILD=12    ,  EMBEDDED_BAREMENTAL
export CROSS_BUILD=1
# Debug build
export ARMCB_DEBUG_BUILD=1
# Static build to disable dynamical libraries compile
export ARMCB_STATIC_COMPILE=0
# build arm bit64 or bit32

if [ ${TARGET_CHIP} == "tx536" ]; then
export ARMCB_AARCH64_BUILD=1
else
export ARMCB_AARCH64_BUILD=0
fi

# Export project name
#      HW_BUILD_FOR_I5      ,  I5  version
#      HW_BUILD_FOR_I5_R1P0 ,  I5 R1P0 version
#      HW_BUILD_FOR_I3      ,  I3  version
#      HW_BUILD_FOR_CUST0   ,  custom0 version
#      HW_BUILD_FOR_TITIAN  ,  TITAIN HW version
export ARMCB_ISP_PROJECT=HW_BUILD_FOR_CUST0
export ARMCB_CUST_BUILD=1

if [ ${CROSS_BUILD} -eq 0 ]; then
    TARGET_PLATFORM="PC_LINUX"
elif [ ${CROSS_BUILD} -eq 1 ]; then
    TARGET_PLATFORM="EMBEDDED_LINUX"
elif [ ${CROSS_BUILD} -eq 2 ]; then
    TARGET_PLATFORM="EMBEDDED_BAREMENTAL"
fi
HARDWARE_VER=${ARMCB_ISP_PROJECT}

if [ ${TARGET_CHIP} == "" ]; then
    TARGET_CHIP="unspecified"
fi

export BUILD_OPTION_UCLIBC=0
if [ ${TARGET_LIBC} == "uclibc" ]; then
    BUILD_OPTION_UCLIBC=1
fi

###############################################################################################
##################################### Build Guide Function ####################################
###############################################################################################

function build_guidance()
{
    echo " "
    echo "################# Default Build Options #################"
    echo "###"
    echo "### TARGET PLATFORM:  ${TARGET_PLATFORM}"
    echo "### TARGET CHIP:      ${TARGET_CHIP}"
    echo "### HARDWARE VERSION: ${HARDWARE_VER}"
    echo "###"

    #while true; do
    #    read -p "####### Launch Build with Default Options? (y/n) ######## " DEFAULT_BUILD
    #    case ${DEFAULT_BUILD} in
    #        [Yy]* ) DEFAULT_BUILD=1; break;;
    #        [Nn]* ) DEFAULT_BUILD=0; break;;
    #    esac
    #done
    DEFAULT_BUILD=1

    if [ ${DEFAULT_BUILD} -eq 0 ]; then

        echo "###"
        echo "############### Choose the Target Platform ##############"
        echo "###"
        echo "### 1. PC Linux"
        echo "### 2. Embedded Linux"
        echo "### 3. Embedded Baremental"
        echo "###"

        while true; do
            read -p "######## Which Is Your Target Platform? (1/2/3) ######### " PLATFORM_NO
            case ${PLATFORM_NO} in
                1) export CROSS_BUILD=0;
                TARGET_PLATFORM="PC_LINUX";
                break;;
                2) export CROSS_BUILD=1;
                TARGET_PLATFORM="EMBEDDED_LINUX";
                break;;
                3) export CROSS_BUILD=2;
                TARGET_PLATFORM="EMBEDDED_BAREMENTAL";
                break;;
            esac
        done

        echo "###"
        echo "############### Choose the Hardware Version #############"
        echo "###"
        echo "### 1. I5_R0P0"
        echo "### 2. I5_R1P0"
        echo "### 3. I7_R0P0"
        echo "### 4. CUST0"
        echo "###"

        while true; do
            read -p "### Which Hardware Version To Be Compiled? (1/2/3/4) #### " HARDWARE_NO
            case ${HARDWARE_NO} in
                1) export ARMCB_ISP_PROJECT=HW_BUILD_FOR_I5;
                HARDWARE_VER="I5_R0P0";
                break;;
                2) export ARMCB_ISP_PROJECT=HW_BUILD_FOR_I5_R1P0;
                HARDWARE_VER="I5_R1P0";
                break;;
                3) export ARMCB_ISP_PROJECT=HW_BUILD_FOR_TITIAN;
                HARDWARE_VER="I7_R0P0";
                break;;
                4) export ARMCB_ISP_PROJECT=HW_BUILD_FOR_CUST0;
                HARDWARE_VER="CUST0";
                break;;
            esac
        done

        echo "###"
        echo "################ Choose the Build Version ###############"
        echo "###"
        echo "### 1. DEBUG"
        echo "### 2. PERFORMANCE"
        echo "###"

        while true; do
            read -p "########## Which Version To Be Built? (1/2) ########### " BUILD_NO
            case ${BUILD_NO} in
                1) export ARMCB_DEBUG_BUILD=1
                export ARMCB_ENABLE_SANITIZE=0
                BUILD_VER="DEBUG";
                break;;
                2) export ARMCB_DEBUG_BUILD=0
                export ARMCB_ENABLE_SANITIZE=0
                BUILD_VER="PERFORMANCE";
                break;;
            esac
        done

        if [ ${CROSS_BUILD} -lt 2 ]; then
            echo "###"
            while true; do
                read -p "############## Enable Static Compile? (y/n) ############# " ENABLE_STATIC_COMPILE
                case ${ENABLE_STATIC_COMPILE} in
                    [Yy]* ) export ARMCB_STATIC_COMPILE=1; break;;
                    [Nn]* ) export ARMCB_STATIC_COMPILE=0; break;;
                esac
            done
        fi

        if [ ${CROSS_BUILD} -eq 2 ]; then
            export ARMCB_STATIC_COMPILE=1;
            echo "###"
            while true; do
                read -p "########## Rebuild Peripheral Libraries? (y/n) ########## " REBUILD_PERIPHERAL
                case ${REBUILD_PERIPHERAL} in
                    [Yy]* ) export REBUILD_PERIPHERAL=1; break;;
                    [Nn]* ) export REBUILD_PERIPHERAL=0; break;;
                esac
            done
        fi
    fi
}

###############################################################################################
#################################### Build Process Function ###################################
###############################################################################################

function assert()
{
    if [ $1 -ne 0 ]; then
        echo "Failed  : "$?
        cd ${ARMCB_CUR_DIR}
        exit 1
    fi
}

######################################## Noncross Build #######################################

function normal_build()
{
    ### Build
    cd ${ARMCB_TEMP_DIR}
    cmake .
    make -j8

    ### Install
    make install

    cp -rf ${ARMCB_SRC_DIR}/app_layer       ${ARMCB_TEMP_DIR}/
    cp -rf ${ARMCB_TEMP_DIR}/common.cmake   ${ARMCB_TEMP_DIR}/app_layer/build/
    cp -rf ${ARMCB_TEMP_DIR}/env.cmake      ${ARMCB_TEMP_DIR}/app_layer/build/
    cd ${ARMCB_TEMP_DIR}/app_layer/build/

    sed -i '1iinclude(common.cmake)' ${ARMCB_TEMP_DIR}/app_layer/build/CMakeLists.txt
    sed -i '1iproject("isp")' ${ARMCB_TEMP_DIR}/app_layer/build/CMakeLists.txt
    sed -i '1icmake_minimum_required(VERSION 2.8.5)' ${ARMCB_TEMP_DIR}/app_layer/build/CMakeLists.txt
    sed -i '1iset(CMAKE_CXX_COMPILER_WORKS 1)' ${ARMCB_TEMP_DIR}/app_layer/build/CMakeLists.txt
    sed -i '1iset(CMAKE_C_COMPILER_WORKS 1)' ${ARMCB_TEMP_DIR}/app_layer/build/CMakeLists.txt

    cmake .
    assert $?

    make -j8
    assert $?

}

