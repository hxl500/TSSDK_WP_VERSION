#!/bin/bash
#
# An example hook script to verify what is about to be committed.
# Called by "git commit" with no arguments.  The hook should
# exit with non-zero status after issuing an appropriate message if
# it wants to stop the commit.
#
# To enable this hook, rename this file to "pre-commit".

FILE_LIST=""
function get_file_list()
{
	FILE_LIST=$(git status -s | grep -v  -e ^[D] | awk ' /^[A-Z]/\
		{ \
			if($1=="R") {list=list "\n" $4} \
			else {list=list " \n" $2} \
		} \
		END { print list }')
}

CHK_FILE_LIST=""
function chk_file_list()
{
	local file
	local ignore

	if [ ! -f ./codestyle_ignore ] ; then
		echo "file codestyle_ignore not exist"
		CHK_FILE_LIST=${FILE_LIST}
		return
	fi

	for file in ${FILE_LIST} ; do
		ignore=""
		while read -r line || [[ -n ${line} ]]
		do
			if [ -z "${line}" ] ; then
				continue
			fi

			ignore=$(echo $file | grep ^"$line")
			if [ "x"${ignore} != "x" ] ; then
				echo "ignore file: $file"
				break
			fi
		done < codestyle_ignore

		if [ "x"${ignore} = "x" ] ; then
			CHK_FILE_LIST=$(echo ${CHK_FILE_LIST} ${file})
		fi
	done
}

echo "run:  $0"
if [ x${TARGET_KERNEL_DIR} != x"" ]; then
	checkpatch=${TARGET_KERNEL_DIR}/scripts/checkpatch.pl
else
	checkpatch=../kernel/scripts/checkpatch.pl
fi
echo "use ${checkpatch} to check added files"

get_file_list
echo -e "git modify & rename files: $FILE_LIST\n"

chk_file_list
echo "need check files: $CHK_FILE_LIST"

${checkpatch} -f --ignore NEW_TYPEDEFS \
	--ignore UNDOCUMENTED_DT_STRING \
	--ignore LOGGING_CONTINUATION \
	--ignore NEEDLESS_IF \
	--ignore COMPLEX_MACRO \
	--ignore INCLUDE_LINUX \
	--ignore CONFIG_DESCRIPTION \
	--ignore LONG_LINE_STRING \
	--ignore NOT_UNIFIED_DIFF \
	--ignore SYMBOLIC_PERMS \
	--ignore LINE_CONTINUATIONS \
	--max-line-length=120 \
	--show-types ${CHK_FILE_LIST}

if [ $? == 0 ]; then
	echo -e "\n\n========================checkpatch pass=====================\n"
else
	echo -e "\n\n=====checkpatch error, please commit again after corret it==\n"
	exit 1

