#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	compatible = "ts,tx536";
	#address-cells = <2>;
	#size-cells = <2>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x0>;
			next-level-cache = <&l2>;
			//operating-points-v2 = <&cpu_opp_table>;
			//cpu-idle-states = <&CPU_SLEEP_0>;
		};

		cpu1: cpu@1 {
			compatible = "arm,cortex-a53", "arm,armv8";
			device_type = "cpu";
			enable-method = "psci";
			reg = <0x1>;
			next-level-cache = <&l2>;
			//operating-points-v2 = <&cpu_opp_table>;
			//cpu-idle-states = <&CPU_SLEEP_0>;
		};

/*
 *		idle-states {
 *			entry-method = "arm,psci";
 *
 *			CPU_SLEEP_0: cpu-sleep-0 {
 *				compatible = "arm,idle-state";
 *				arm,psci-suspend-param = <0x40000000>;
 *				local-timer-stop;
 *				entry-latency-us = <300>;
 *				exit-latency-us = <600>;
 *				min-residency-us = <10000>;
 *			};
 *		};
 */
		l2: l2-cache0 {
			compatible = "cache";
		};
	};

/*
 *	cpu_opp_table: cpu_opp_table {
 *		compatible = "operating-points-v2";
 *		opp-shared;
 *		opp00 {
 *			opp-hz = /bits/ 64 <1199999988>;
 *			opp-microvolt = <1000000>;
 *			clock-latency-ns = <500000>;
 *		};
 *		opp01 {
 *			opp-hz = /bits/ 64 <599999994>;
 *			opp-microvolt = <1000000>;
 *			clock-latency-ns = <500000>;
 *		};
 *		opp02 {
 *			opp-hz = /bits/ 64 <399999996>;
 *			opp-microvolt = <1000000>;
 *			clock-latency-ns = <500000>;
 *		};
 *		opp03 {
 *			opp-hz = /bits/ 64 <299999997>;
 *			opp-microvolt = <1000000>;
 *			clock-latency-ns = <500000>;
 *		};
 *	};
 */

	dcc: dcc {
		compatible = "arm,dcc";
		status = "disabled";
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
				 <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <1 13 0x308>,
			     <1 14 0x308>,
			     <1 11 0x308>,
			     <1 10 0x308>;
		/*always-on;*/
	};

	amba_apu: amba_apu@0 {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <1>;
		ranges = <0 0 0 0 0xffffffff>;

		gic: interrupt-controller@f0e90000 {
			compatible = "arm,gic-400", "arm,cortex-a15-gic";
			#interrupt-cells = <3>;
			reg = <0x0 0xf0e91000 0x1000>,
				  <0x0 0xf0e92000 0x2000>,
				  <0x0 0xf0e94000 0x2000>,
				  <0x0 0xf0e96000 0x2000>;
			interrupt-controller;
			interrupt-parent = <&gic>;
			interrupts = <1 9 0x304>;
		};
	};

	//temp
	sgrf: syscon@f128d000 {
		compatible = "ts,tx536-sgrf", "syscon";
		reg = <0x0 0xf128d000 0x0 0x1000>;
	};

	//temp
	smu: syscon@f12a2000 {
		compatible = "ts,tx536-smu", "syscon";
		reg = <0x0 0xf12a2000 0x0 0x1000>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
		calibration = <0x8000>;
	};

	lp_rtc: lp_rtc {
		status = "disabled";
		compatible = "ts,lp_rtc";
		reg = <0x0 0xf12a2118 0x0 0x20>;
		interrupt-parent = <&gic>;
		interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>; //lp rtc interrupt nr
		regoff-base = <0x00000000>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		grf: syscon@f128c000 {
			compatible = "ts,tx536-grf", "syscon";
			reg = <0x0 0xf128c000 0x0 0x1000>;
		};

		noc: syscon@f0ea0000 {
			compatible = "ts,tx536-noc", "syscon";
			reg = <0x0 0xf0ea0000 0x0 0x20000>;
		};

		cgu_top: cgu_top@f0d9a000 {
			compatible = "ts,tx536-cgu", "syscon";
			reg = <0x0 0xf0d9a000 0x0 0x1000>;
		};

		dma0: dma-controller@f0e9a000 {
			compatible = "arm,pl330", "arm,primecell";
			status = "disabled";
			reg = <0x0 0xf0e9a000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>,
					 <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
			arm,primecell-periphid = <0x00341330>;
			#dma-cells = <1>;
			iommus = <&smmu 73>, <&smmu 74>, <&smmu 75>, <&smmu 127>, <&smmu 128>;
		};

		rne_dma: rne_dma@f0200000 {
			compatible = "ts,simple-bus-chip-rne";
			status = "disabled";
			reg = <0x0 0xf0200000 0x0 0x200000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&smmu 103>;
		};

		rce_dma: rce_dma@f0400000 {
			compatible = "ts,simple-bus-chip-rce";
			status = "disabled";
			reg = <0x0 0xf0400000 0x0 0x200000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
			iommus = <&smmu 102>;
		};

		uart1: serial@f0d8a000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d8a000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart2: serial@f0d8b000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 23 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d8b000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart3: serial@f0d8c000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d8c000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart4: serial@f0d8d000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d8d000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart5: serial@f0d8e000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d8e000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart6: serial@f0d8f000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d8f000 0x0 0x1000>;
			reg-shift = <2>;
		};

		usart0: usi0-uart@f1284000 {
			compatible = "ts,ts-usi-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 93 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf1284000 0x0 0x1000>;
			reg-shift = <2>;
		};

		usart1: usi1-uart@f1285000 {
			compatible = "ts,ts-usi-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf1285000 0x0 0x1000>;
			reg-shift = <2>;
		};

		usart2: usi2-uart@f0d88000 {
			compatible = "ts,ts-usi-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d88000 0x0 0x1000>;
			reg-shift = <2>;
		};

		usart3: usi3-uart@f0d89000 {
			compatible = "ts,ts-usi-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d89000 0x0 0x1000>;
			reg-shift = <2>;
		};

		ui2c0: usi3-i2c@f0d89000 {
			compatible = "ts,ts-usi-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d89000 0x0 0x1000>;
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		uspi2: usi2spi@f0d88000 {
			compatible = "ts,ts-spi";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d88000 0x0 0x1000>;
			reg-shift = <2>;
			uspics-gpios = <&portb 11 GPIO_ACTIVE_HIGH>;
		};

		gmac0: ethernet0@f0d60000 {
			compatible = "ts-tx536,dwc-qos-ethernet-4.10";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d60000 0x0 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;

			snps,write-requests = <2>;
			snps,read-requests = <16>;
			snps,no-pbl-x8;
			snps,txpbl = <8>;
			snps,rxpbl = <2>;
			iommus = <&smmu 59>;
			ts,clkctl = <&cgu_top>;
			status = "disabled";
		};

		pinctrl: pinctrl@f0d95000 {
			compatible = "ts,ts-pinctrl-tx536";
			reg = <0x0 0xf0d95000 0x0 0x1000>;
			ts,npins = <97>;
		};

		mcu_pinctrl: mcu_pinctrl@f128a000 {
			compatible = "ts,ts-pinctrl-tx536";
			reg = <0x0 0xf128a000 0x0 0x1000>;
			ts,npins = <30>;
		};

		gpio0: gpio@f0d94000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0xf0d94000 0x0 0x400>;

			porta: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
				gpio-ranges = <&pinctrl 0 0 5>,
							<&pinctrl 5 96 1>,
							<&pinctrl 6 6 26>;
			};
		};

		gpio1: gpio@f0d94400 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0xf0d94400 0x0 0x400>;

			portb: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
				gpio-ranges = <&pinctrl 0 32 32>;
			};
		};

		gpio2: gpio@f0d94800 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0xf0d94800 0x0 0x400>;

			portc: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <32>;
				reg = <0>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
				gpio-ranges = <&pinctrl 0 64 32>;
			};
		};

		gpio3: gpio@f1289000 {
			#address-cells = <1>;
			#size-cells = <0>;
			compatible = "snps,dw-apb-gpio";
			reg = <0x0 0xf1289000 0x0 0x400>;

			mcu_gpio: gpio-controller@0 {
				compatible = "snps,dw-apb-gpio-port";
				gpio-controller;
				#gpio-cells = <2>;
				snps,nr-gpios = <30>;
				reg = <0>;
				interrupt-controller;
				#interrupt-cells = <2>;
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
				gpio-ranges = <&mcu_pinctrl 0 0 30>;
			};
		};

		gpio4: aon-gpio {
			compatible = "ts,aon-gpio-tx536";
			status = "disabled";
			ts,smu = <&smu>;
			reg = <0x0 0xf12a2000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		mcu_i2c0: i2c@f1281000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf1281000 0x0 0x1000>;
			clock-frequency = <400000>;
			// pinctrl-names = "default";
			//pinctrl-0 = <&i2c0_pinctrl>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		mcu_i2c1: i2c@f1282000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf1282000 0x0 0x1000>;
			clock-frequency = <400000>;
			// pinctrl-names = "default";
			//pinctrl-0 = <&i2c1_pinctrl>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c2: i2c@f0d80000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d80000 0x0 0x1000>;
			clock-frequency = <400000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c2_pinctrl>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c3: i2c@f0d81000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d81000 0x0 0x1000>;
			clock-frequency = <400000>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c4: i2c@f0d82000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 32 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d82000 0x0 0x1000>;
			clock-frequency = <400000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c4_pinctrl>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c5: i2c@f0d83000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d83000 0x0 0x1000>;
			clock-frequency = <400000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c5_pinctrl>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c6: i2c@f0d84000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d84000 0x0 0x1000>;
			clock-frequency = <400000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c6_pinctrl>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c7: i2c@f0d85000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d85000 0x0 0x1000>;
			clock-frequency = <400000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c7_pinctrl>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c8: i2c@f0d86000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d86000 0x0 0x1000>;
			clock-frequency = <400000>;
			pinctrl-names = "default";
			pinctrl-0 = <&i2c8_pinctrl>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		i2c9: i2c@f0d87000 {
			compatible = "snps,designware-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d87000 0x0 0x1000>;
			clock-frequency = <400000>;
			rx-depth = <16>;
			tx-depth = <16>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		nand0: nand@f0da8000 {
			compatible = "ts,tx536-nand";
			reg = <0x0 0xf0da8000 0x0 0x2000>;
			reg-names = "ts-nand";
			#address-cells = <1>;
			#size-cells = <1>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 70 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "bch";
			//dmas = <&dma_apbh 0>;
			//dma-names = "rx-tx";
			#stream-id-cells = <1>;
			iommus = <&smmu 70>;
			//power-domains = <&zynqmp_firmware PD_NAND>;

			status = "disabled";
		};

		smmu: smmu@f0800000 {
			compatible = "arm,mmu-500", "arm,smmu-v2";
			reg = <0x0 0xf0800000 0x0 0x400000>;
			#iommu-cells = <1>;
			/* always ignore appended 5-bit TBU number */
			stream-match-mask = <0x7c00>;
			status = "disabled";
			#global-interrupts = <2>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>,
				/* performance counter interrupts 0-7 */
				     <0 211 4>, <0 212 4>,
				     <0 213 4>, <0 214 4>,
				     <0 215 4>, <0 216 4>,
				     <0 217 4>, <0 218 4>,
				/* per context interrupt, 64 interrupts */
				     <0 162 4>, <0 163 4>,
				     <0 164 4>, <0 165 4>,
				     <0 166 4>, <0 167 4>,
				     <0 168 4>, <0 169 4>,
				     <0 170 4>, <0 171 4>,
				     <0 172 4>, <0 173 4>,
				     <0 174 4>, <0 175 4>,
				     <0 176 4>, <0 177 4>,
				     <0 178 4>, <0 179 4>,
				     <0 180 4>, <0 181 4>,
				     <0 182 4>, <0 183 4>,
				     <0 184 4>, <0 185 4>,
				     <0 186 4>, <0 187 4>,
				     <0 188 4>, <0 189 4>,
				     <0 190 4>, <0 191 4>,
				     <0 192 4>, <0 193 4>,
				     <0 194 4>, <0 195 4>,
				     <0 196 4>, <0 197 4>,
				     <0 198 4>, <0 199 4>,
				     <0 200 4>, <0 201 4>,
				     <0 202 4>, <0 203 4>,
				     <0 204 4>, <0 205 4>,
				     <0 206 4>, <0 207 4>,
				     <0 208 4>, <0 209 4>;
			interrupt-names = "sec", "no-sec";
		};

		bt1120tx: bt1120tx@f0d9c000 {
			compatible = "ts,bt1120tx", "tx536,bt1120tx";
			reg = <0x0 0xf0d9c000 0 0x1000>;
			reg-names = "ts-bt1120tx";
			/*memory-region = <&bt1120tx_reserved>;*/
			/*#address-cells = <1>;*/
			/*#size-cells = <1>;*/
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "dma_tx";

			pinctrl-name = "default";
			pinctrl-0 = <&bt1120_tx_pinctrl>;
			#stream-id-cells = <1>;
			iommus = <&smmu 43>;

			status = "disabled";
		};

		bt1120rx: bt1120rx@f0d9d000 {
			compatible = "ts,bt1120rx", "tx536,bt1120rx";
			reg = <0x0 0xf0d9d000 0 0x1000>;
			reg-names = "ts-bt1120rx";
			/*memory-region = <&bt1120rx_reserved>;*/
			/*#address-cells = <1>;*/
			/*#size-cells = <1>;*/
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-name = "dma_rx";

			pinctrl-names = "default";
			pinctrl-0 = <&bt1120_rx_pinctrl>;
			#stream-id-cells = <1>;
			iommus = <&smmu 44>;

			status = "disabled";
		};

