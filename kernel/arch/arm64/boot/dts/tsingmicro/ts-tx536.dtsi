		usb0: usb0@f0c00000 {
			compatible = "ts,dwc3";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			dwc3@f0c00000 {
				compatible = "snps,dwc3";
				status = "okay";
				reg = <0x0 0xf0c00000 0x0 0x100000>;
				interrupt-parent = <&gic>;
				interrupts = <0 69 4>;

				pinctrl-names = "default";
				pinctrl-0 = <&PA19_pinctrl>;
				drvvbus-gpios = <&porta 19 GPIO_ACTIVE_HIGH>;
				dr_mode = "host";
				/*dr_mode = "peripheral";*/
				snps,quirk-frame-length-adjustment = <0x20>;
				snps,dis_rxdet_inp3_quirk;

				snps,dis_enblslpm_quirk;
				snps,dis-u2-freeclk-exists-quirk;
				snps,dis_u2_susphy_quirk;
				snps,dis-del-phy-power-chg-quirk;
				snps,dis-tx-ipgap-linecheck-quirk;

				grf_addr = <0xf128c000>;
			};
		};


		armcb_camera {
			compatible = "armcb,camera";
			vout-num=<4>;
		};

		armcb_stat {
			compatible = "armcb,statistic";
			stat-name = "armcb,ispstat";
		};

		isp: armcb_isp@0xf0e40000 {
			compatible = "armcb,isp-octob-cus0";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 58 IRQ_TYPE_LEVEL_HIGH>,
					   <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;

			ts,grf = <&grf>;
			ts,sgrf = <&sgrf>;

			mipi0 = <&mipi_csi2host0>;
			mipi1 = <&mipi_csi2host1>;
			mipi2 = <&mipi_csi2host2>;
			tnr = <&tnr>;
			iommus = <&smmu 58>, <&smmu 111>;
		};

