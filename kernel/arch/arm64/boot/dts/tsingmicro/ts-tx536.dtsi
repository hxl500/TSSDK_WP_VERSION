			compatible = "ts,tx536-mailbox";
			reg = <0x0 0xf0d96000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
