			compatible = "ts,isp_tnr";
		};

		ebd: ebd@0xf0e53000 {
			compatible = "ts,ebd";
			reg = <0 0xf0e53000 0 0x1000>;
			reg-names = "ebd";
			ts,grf = <&grf>;
