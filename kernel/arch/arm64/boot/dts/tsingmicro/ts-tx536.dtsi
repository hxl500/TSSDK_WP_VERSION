		hwacc: hwacc {
			compatible = "ts,hwacc";
			status = "disabled";

			//auto find available chan
			dmas = <&dma0 99>;
			dma-names = "m2m";
		};

		i2s0: i2s0@f0da5000 {
			compatible = "ts-i2s,tx536";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 15 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0da5000 0x0 0x1000>;
		};

		i2s1: i2s1@f0da6000 {
			compatible = "ts-i2s,tx536";
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0da6000 0x0 0x1000>;
		};

		adc: adc@0xf0d93000{
			compatible = "tsingmicro,ts-adc";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0d93000 0x0 0x1000 >;
			name-supply = <&LDO2>;
		};

		ocotp: ocotp@f0d92000 {
			compatible = "ts,ts-ocotp";
			status = "disabled";
			reg = <0x0 0xf0d92000 0x0 0x1000>;
			name-supply = <&LDO6>;
		};


		noc_bw: noc_bw {
			compatible = "ts,noc_bw";
			status = "disabled";
			ts,noc = <&noc>;
		};

	};
};
