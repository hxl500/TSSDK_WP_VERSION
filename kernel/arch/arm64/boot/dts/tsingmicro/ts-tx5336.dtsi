		osr_pke: osr_pke@f0320000 {
			compatible = "osr,osr-pke";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0320000 0x0 0x10000>;
		};

		osr_hash: osr_hash@f031e000 {
			compatible = "osr,osr-hash";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf031e000 0x0 0x1000>;
		};

		osr_ske: osr_ske@f031f000 {
			compatible = "osr,osr-ske";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf031f000 0x0 0x1000>;
		};

		osr_trng: osr_trng@f031d000 {
			compatible = "osr,osr-trng";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf031d000 0x0 0x1000>;
		};

		usb0: usb0@0xf0400000 {
			compatible = "snps,dwc2";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0400000  0x0 0x10000>;
			ts,sysctl = <&sysctl>;
#if 1
			dr_mode = "host"; /* host mode */
#else
			dr_mode = "peripheral"; /* device mode */
#endif
		};

