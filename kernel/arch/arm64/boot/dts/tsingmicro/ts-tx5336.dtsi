		 ui2c0: usi0-i2c@f03ec000 {
			compatible = "ts,ts-usi-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03ec000 0x0 0x1000>;
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;
		 };

		 ui2c1: usi1-i2c@f03ed000 {
			compatible = "ts,ts-usi-i2c";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03ed000 0x0 0x1000>;
			clock-frequency = <100000>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		usart0: usi0-uart@f03ec000 {
			compatible = "ts,ts-usi-uart";
			status = "disabled";
