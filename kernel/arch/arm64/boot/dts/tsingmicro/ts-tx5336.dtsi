		mpp: mpp {
			compatible = "ts,mpp";
			status = "disabled";
		};

		mpp_proc: mpp_proc {
			compatible = "ts,mpp_proc";
			status = "disabled";
		};

		vpe: vpe@0xf0364000 {
			compatible = "ts,vpe_v4";
			reg = <0 0xf0364000 0 0x4000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 87 IRQ_TYPE_LEVEL_HIGH>;
			ts,crgu = <&crgu>;
			ts,sysctl = <&sysctl>;
			status = "disabled";
		};
