		mipi_csi2host0: mipi_csi2host@0xf0369000 {
			status = "okay";
			compatible = "ts,mipi-csi2-rx0";
			reg = <0x0 0xf0369000 0x0 0x1000>,
				<0x0 0xf038f080 0x0 0x4>,
				<0x0 0xf036D000 0x0 0x1000>;
			reg-names = "csi", "sysreg_vi_cfg1", "dphy";
			phy = <&mipi_rx_phy>;
		};

		mipi_csi2host1: mipi_csi2host@0xf036a000 {
			status = "okay";
			compatible = "ts,mipi-csi2-rx1";
			reg = <0x0 0xf036a000 0x0 0x1000>,
				<0x0 0xf038f080 0x0 0x4>,
				<0x0 0xf036D000 0x0 0x1000>;
			reg-names = "csi", "sysreg_vi_cfg1", "dphy";
			phy = <&mipi_rx_phy>;
		};

		mipi_csi2host2: mipi_csi2host@0xf036b000 {
			status = "okay";
			compatible = "ts,mipi-csi2-rx2";
			reg = <0x0 0xf036b000 0x0 0x1000>,
				<0x0 0xf038f080 0x0 0x4>,
				<0x0 0xf036E000 0x0 0x1000>;
			reg-names = "csi", "sysreg_vi_cfg1", "dphy";
			phy = <&mipi_rx_phy>;
		};

		mipi_csi2host3: mipi_csi2host@0xf036c000 {
			status = "okay";
			compatible = "ts,mipi-csi2-rx3";
			reg = <0x0 0xf036c000 0x0 0x1000>,
				<0x0 0xf038f080 0x0 0x4>,
				<0x0 0xf036E000 0x0 0x1000>;
			reg-names = "csi", "sysreg_vi_cfg1", "dphy";
			phy = <&mipi_rx_phy>;
		};

		mipi_rx_phy: mipi_rx_phy {
			compatible = "ts,mipi-rx-phy-dw";
		};

		isp: armcb_isp@0xf0340000 {
			compatible = "armcb,isp";
			reg = <0x0 0xf0340000 0x0 0x10000>;
			mipi0 = <&mipi_csi2host0>;
			//mipi1 = <&mipi_csi2host1>;
			mipi2 = <&mipi_csi2host2>;
			//mipi3 = <&mipi_csi2host3>;
		};

		armcb_config {
			compatible = "armcb,config-i7";
			reg = <0x0 0xf0340000 0x0 0x10000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>,
					   <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
		};

		armcb_ispmem {
			compatible = "armcb,isp-mem";

			ts,sysctl = <&sysctl>;
			dmas = <&dw_axi_dmac 0x0 0 0>;
			dma-names = "mdata";
		};

		dof: ts_dof@0xf0368000 {
			compatible = "ts,dof";
			reg = <0x0 0xf0368000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
		};

		dp0: nemadc@f0318000 {
			compatible = "thinksil,nemadc";
			reg = <0x0 0xf0318000 0x0 0x2000>;
			/*memory-region = <&dpu_reserved>;*/
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "DE";
			namedc-output-port-lines = /bits/ 8 <8 8 8>;
			status = "disabled";
		};

		hdmi_virt: hdmi_virt@f0369000 {
			compatible = "ts,ts-virt-hdmi";
			reg = <0x0 0xf0369000 0x0 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		mipi_dsi: mipi@f0316000 {
			compatible = "ts,dw-mipi-dsi";
			#address-cells = <2>;
			#size-cells = <2>;
			ts,sysctl = <&sysctl>;
			reg = <0x0 0xf0316000 0x0 0x1000>,
				<0x0 0xf0317000 0x0 0x1000>;
			interrupts = <GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		ebd: ebd@0xf0360000 {
			compatible = "ts,ebd";
			reg = <0 0xf0360000 0 0x1000>;
			reg-names = "ebd";
			ts,sysctl = <&sysctl>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

