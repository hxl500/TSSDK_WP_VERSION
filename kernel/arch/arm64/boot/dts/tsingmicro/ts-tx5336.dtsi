		};

		systimer1_7: systimer1_7@f0387078 {
			compatible = "snps,dw-apb-timer";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0387078 0x0 0x14>;
			status = "disabled";
		};

		systimer1_8: systimer1_8@f038708c {
			compatible = "snps,dw-apb-timer";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf038708c 0x0 0x14>;
			status = "disabled";
		};

		noc: ts_noc@f0620000 {
			compatible = "ts,tx5336-noc", "syscon";
			reg = <0x0 0xf0620000 0x0 0x20000>;
			//status = "disabled";
		};

		crgu: syscon@f038a000 {
			compatible = "ts,tx5336-crgu", "syscon";
			reg = <0x0 0xf038a000 0x0 0x1000>;
		};

		//dma0: dma-controller@f0e9a000 {
		//	compatible = "arm,pl330", "arm,primecell";
		//	status = "disabled";
		//	reg = <0x0 0xf0e9a000 0x0 0x1000>;
		//	interrupt-parent = <&gic>;
		//	interrupts = <GIC_SPI 73 IRQ_TYPE_LEVEL_HIGH>,
		//			<GIC_SPI 74 IRQ_TYPE_LEVEL_HIGH>,
		//			<GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>,
		//			<GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>,
		//			<GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
		//	arm,primecell-periphid = <0x00341330>;
		//	#dma-cells = <1>;
		//};

		dwahbdma0: dwahbdma0@f0510000 {
			compatible = "snps,dma-spear1340-new";
			reg = <0x0 0xf0510000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
			dma-channels = <6>;
			#dma-cells = <3>;
			dma-requests = <16>;
			chan_allocation_order = <1>;
			chan_priority = <1>;
			block_size = <3072>;
			dma-masters = <2>;
			data-width = <4 4>;
			mem-master=<1>;
			dev-master=<0>;
		};

		dwahbdma1: dwahbdma1@f0511000 {
			compatible = "snps,dma-spear1340-new";
			reg = <0x0 0xf0511000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
			dma-channels = <6>;
			#dma-cells = <3>;
			dma-requests = <16>;
			chan_allocation_order = <1>;
			chan_priority = <1>;
			block_size = <3072>;
			dma-masters = <2>;
			data-width = <4 4>;
			mem-master=<1>;
			dev-master=<0>;
		};

		rne_dma: rne_dma@f0200000 {
			compatible = "ts,simple-bus-chip-rne";
			status = "disabled";
			reg = <0x0 0xf0700000 0x0 0x100000>,
				  <0x0 0xf0a00000 0x0 0x100000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH>;
		};

		// rce_dma: rce_dma@f0400000 {
			// compatible = "ts,simple-bus-chip-rce";
			// status = "disabled";
			// reg = <0x0 0xf0400000 0x0 0x200000>;
			// interrupt-parent = <&gic>;
			// interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
		// };

		uart0: serial@f03e7000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03e7000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart1: serial@f03e8000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03e8000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart2: serial@f03e9000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03e9000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uart3: serial@f03ea000 {
			compatible = "snps,dw-apb-uart";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03ea000 0x0 0x1000>;
			reg-shift = <2>;
		};

		gmac0: ethernet0@f0500000 {
			compatible = "ts-tx5336,dwc-qos-ethernet-4.10";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>,
						 <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0500000 0x0 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;
			snps,write-requests = <2>;
			snps,read-requests = <16>;
			//snps,no-pbl-x8;
			snps,txpbl = <4>;
			snps,rxpbl = <2>;
#if 1
			rx-fifo-depth = <16000>;
			tx-fifo-depth = <16000>;
			snps,force_thresh_dma_mode;
#endif
			ts,clkctl = <&crgu>;
			status = "disabled";
		};

		bis: bis@f0314000 {
			compatible = "ts,bis";
			reg = <0 0xf0314000 0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <0 61 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		cve: cve@f031b000 {
			compatible = "ts,cve_dt53";
			reg = <0 0xf031b000 0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <0 70 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		sys: sys {
			compatible = "ts,sys";
			status = "disabled";
		};

		gdc: gdc@f0315000 {
			compatible = "ts,gdc";
			reg = <0 0xf0315000 0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		amr: amr@f031a000 {
			compatible = "ts,amr";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 73 IRQ_TYPE_EDGE_RISING>;
			reg = <0 0xf031a000 0 0x1000>;
		};

		pinctrl_func_exchange: pinctrl_func@f0000000 {
			status = "disabled";
			compatible = "pinctrl_func_exchange";
		};

