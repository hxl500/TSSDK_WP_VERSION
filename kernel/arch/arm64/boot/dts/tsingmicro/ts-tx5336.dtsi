		hwacc: hwacc {
			compatible = "ts,hwacc";
			status = "disabled";

			//auto find available chan
			dmas = <&dw_axi_dmac 99 0 0>;
			dma-names = "m2m";
		};

		hwacc_sg: hwacc_sg {
			compatible = "ts,hwacc-sg";
			status = "disabled";
			//auto find available chan
			/* only ahbdma can use s-g mode*/
			dmas = <&dwahbdma0 99 0 0>;
			dma-names = "m2m";
		};

		ts_codec: ts_codec@f0618000 {
			compatible = "ts-codec,tx5336";
			reg = <0 0xf0618000 0 0x4000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 1 IRQ_TYPE_LEVEL_HIGH>;
			ts,sysctl = <&sysctl>;
			ts,crgu = <&crgu>;
			status = "disabled";
		};

		i2s: i2s@f03ee000 {
			compatible = "ts-i2s,tx5336";
			status = "disabled";
			ts,crgu = <&crgu>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03ee000 0x0 0x1000>;
		};

		gpadc: gpadc@f0382000{
			compatible = "tsingmicro,ts-gpadc-5336";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0382000 0x0 0x1000 >;
			sysreg_addr = <0xF038F000>;
		 };

		ocotp: ocotp@f0381000 {
			compatible = "ts,ts-ocotp";
			status = "disabled";
			reg = <0x0 0xf0381000 0x0 0x1000>;
		};

		pdmic0: pdmic@f038B000 {
			compatible = "tsingmicro,ts-pdmic";
			reg = <0x0 0xf038B000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		pdmic1: pdmic@f038C000 {
			compatible = "tsingmicro,ts-pdmic";
			reg = <0x0 0xf038C000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		pdmic2: pdmic@f038D000 {
			compatible = "tsingmicro,ts-pdmic";
			reg = <0x0 0xf038D000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 29 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		pdmic3: pdmic@f038E000 {
			compatible = "tsingmicro,ts-pdmic";
			reg = <0x0 0xf038E000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
		};

		irproc: irproc@f0514000 {
			compatible = "ts,ts-irproc";
			status = "disabled";
			reg = <0x0 0xf0514000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
		};

		vpu: linlon-v8@f03d0000 {
			compatible = "armChina,linlon-v8";
			reg = <0x0 0xF03D0000 0x0 0x10000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
		};
	};
};
