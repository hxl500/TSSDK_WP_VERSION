			reg-shift = <2>;
		 };

		uspi0: usi0spi@f03ec000 {
			compatible = "ts,ts-spi";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03ec000 0x0 0x1000>;
			reg-shift = <2>;
		};

		uspi1: usi1spi@f03ed000 {
			compatible = "ts,ts-spi";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf03ed000 0x0 0x1000>;
			reg-shift = <2>;
		};

		// pinctrl: pinctrl@f0d95000 {
			// compatible = "ts,ts-pinctrl";
			// reg = <0x0 0xf0d95000 0x0 0x1000>;
