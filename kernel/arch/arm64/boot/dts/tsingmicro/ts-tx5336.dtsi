			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf038608c 0x0 0x14>;
			status = "disabled";
		};

		systimer1_1: systimer1_1@f0387000 {
			compatible = "snps,dw-apb-timer";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0387000 0x0 0x14>;
			status = "disabled";
		};

		systimer1_2: systimer1_2@f0387014 {
			compatible = "snps,dw-apb-timer";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0387014 0x0 0x14>;
			status = "disabled";
		};

		systimer1_3: systimer1_3@f0387028 {
			compatible = "snps,dw-apb-timer";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0387028 0x0 0x14>;
			status = "disabled";
		};

		systimer1_4: systimer1_4@f038703c {
			compatible = "snps,dw-apb-timer";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf038703c 0x0 0x14>;
			status = "disabled";
		};

		systimer1_5: systimer1_5@f0387050 {
			compatible = "snps,dw-apb-timer";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0387050 0x0 0x14>;
			status = "disabled";
