			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0386050 0x0 0x14>;
			status = "disabled";
		};

		systimer0_6: systimer0_6@f0386064 {
