		rtc: rtc@F0516000 {
			compatible = "ts,rtc";
			status = "disabled";
			reg = <0x0 0xF0516000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			calibration = <0x8000>;
		};

		lp_rtc: lp_rtc {
			compatible = "ts,lp_rtc";
			reg = <0x0 0xf0517140 0x0 0x20>;  //sync with smu
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>; //sync with smu
			regoff-base = <0x00000000>;
			status = "disabled";
		};

		qspi: spi@f0380000 {
			compatible = "cdns,qspi-nor", "ts,qspi-nand";
			status = "disabled";
			#address-cells = <2>;
			#size-cells = <2>;
			reg = <0x0 0xf0380000 0x0 0x1000>,
			    <0x0 0xe0000000 0x0 0x10000000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 0 IRQ_TYPE_LEVEL_HIGH>;
			/*cdns,is-decoded-cs;*/
			cdns,fifo-depth = <256>;
			cdns,fifo-width = <4>;
			cdns,trigger-address = <0xe0000000>;
			/*cdns,is-decoded-cs = <0>;*/
			// iommus = <&smmu 46>;
		};

		dw_axi_dmac: dw_axi_dmac@f031c0000 {
			compatible = "snps,axi-dma-1.01a";
			status = "disabled";
			reg = <0x0 0xf031c000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
			#dma-cells = <3>;
			dma-channels = <2>;
			dma-requests = <10>;
			snps,dma-masters = <1>;
			snps,data-width = <4>;
			snps,block-size = <65536 65536>;
			snps,priority = <0 1>;
			snps,axi-max-burst-len = <4>;
		};

		 pwm: pwm@F03EB000 {
			 compatible = "pwm-ts";
			 status = "disabled";
			 reg = <0x0 0xF03EB000 0x0 0x1000>;
			 interrupt-parent = <&gic>;
			 interrupts = <GIC_SPI 12 IRQ_TYPE_LEVEL_HIGH>;
			 pwm,channels = <12>;
			 pwm,max_period_us = <10000>;
			 #pwm-cells = <2>;
		 };

		sdhci0: mmc@f0512000 {
			compatible = "snps,dw-mshc";
			status = "disabled";
			reg = <0x0 0xf0512000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
			bus-width = <4>;
		};

		sdhci1: mmc@f0513000 {
			compatible = "snps,dw-mshc";
			status = "disabled";
			reg = <0x0 0xf0513000 0x0 0x1000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>;
		};

		spi0: spi@f0383000 {
			compatible = "snps,dw-apb-ssi";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 48 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0383000 0x0 0x1000>;
			reg-io-width = <4>;
			num-cs = <1>;
			dmas = <&dw_axi_dmac 0x1 0 0 &dw_axi_dmac 0x0 0 0>;
			dma-names = "tx", "rx";
		};

		spi1: spi1@f0384000 {
			compatible = "snps,dw-apb-ssi";
			status = "disabled";
			interrupt-parent = <&gic>;
			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x0 0xf0384000 0x0 0x1000>;
			reg-io-width = <4>;
			num-cs = <1>;
			dmas = <&dw_axi_dmac 0x3 0 0 &dw_axi_dmac 0x2 0 0>;
			dma-names = "tx", "rx";
		};

