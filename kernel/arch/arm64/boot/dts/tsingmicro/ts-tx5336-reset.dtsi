&qspi {
	resets = <&ts_reset TS_QSPI_REF_RST>,
			<&ts_reset TS_QSPI_AHB_RST>,
			<&ts_reset TS_QSPI_APB_RST>;
	reset-names = "ospi_ref", "ospi_ahb", "ospi_apb";
};
