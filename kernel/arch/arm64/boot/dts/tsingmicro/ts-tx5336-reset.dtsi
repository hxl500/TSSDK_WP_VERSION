	resets = <&ts_reset TS_USB_PHY_RST>;
	reset-names = "usbphy";
};

&ocotp {
	resets = <&ts_reset TS_OTPC_APB_RST>;
	reset-names = "ts_otpc";
};

&pdmic0 {
