#include <dt-bindings/reset/ts-tx5336-resets.h>
/ {
	ts_reset: reset-controller {
		compatible = "ts,tx5336-reset";
		reg = <0x0 0xF038A000 0x0 0x1000>;
		#reset-cells = <1>;
	};
};

// &dma0 {
	// resets = <&ts_reset TS_RST_DMAC0>;
	// reset-names = "dma";
// };

&gmac0 {
	 resets = <&ts_reset TS_RST_GMAC_GLOBAL>;
	 reset-names = "stmmaceth";
};

&sdhci0 {
    resets = <&ts_reset TS_SDHCI0_AHB_RST>;
    reset-names = "sdhci";
};

&sdhci1 {
    resets = <&ts_reset TS_SDHCI1_AHB_RST>;
    reset-names = "sdhci";
};

