&ts_codec {
	clocks = <&ts_clk TS_CLK_TX5336_AUD_CODEC_AHB_CLK>,
			<&ts_clk TS_CLK_TX5336_AUD_DAC_CCLK>,
			<&ts_clk TS_CLK_TX5336_AUD_DAC_PBCLK>,
			<&ts_clk TS_CLK_TX5336_AUD_ADC_CCLK>,
			<&ts_clk TS_CLK_TX5336_AUD_ED_TMR_STRB_CLK>;
	clock-names = "aud_codec_ahb_clk","dac_cclk","dac_pbclk", "adc_cclk","ed_tmr_strb";

	assigned-clocks = <&ts_clk TS_CLK_TX5336_AUD_CODEC_AHB_CLK>,        
						<&ts_clk TS_CLK_TX5336_AUD_DAC_CCLK>,           
						<&ts_clk TS_CLK_TX5336_AUD_DAC_PBCLK>,          
						<&ts_clk TS_CLK_TX5336_AUD_ADC_CCLK>,           
						<&ts_clk TS_CLK_TX5336_AUD_ED_TMR_STRB_CLK>;
	assigned-clock-rates = <200000000>, <87739286>, <6749176>, <6144000>, <0>; /* max, DAC_PBCLK and ED_TMR_STRB_CLK follow DAC_CCLK*/
	// assigned-clock-rates = <62500000>, <300000>, <0>, <300000>, <0>; /* min */
};

