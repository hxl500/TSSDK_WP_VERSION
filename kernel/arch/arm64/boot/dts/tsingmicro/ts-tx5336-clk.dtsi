&usb0 {
	/* peri2_ahb_clk -> usb_ahb_clk 200MHz, pll0_d4_usb_ref_clk(500MHz) / osc_usb_ref_clk -> usb_ref */
	clocks = <&ts_clk TS_CLK_TX5336_USB_REF_CLK>,<&ts_clk TS_CLK_TX5336_USB_AHB_CLK>;
	//clock-names = "phy_clk","otg";
	clock-names = "usb_ref_clk","usb_ahb_clk";

	#if 1
	assigned-clocks = <&ts_clk TS_CLK_TX5336_USB_REF_CLK>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5336_OSC_24M>;  //24M
	assigned-clock-rates = <24000000>;
	//assigned-clock-parents = <&ts_clk TS_CLK_TX5336_USB_REF_PLL0_D4_CLK>;  //50M
	//assigned-clock-rates = <50000000>;
	#endif
};

&rne_dma {
	clocks = <&ts_clk TS_CLK_TX5336_RNE_AHB_CLK>, <&ts_clk TS_CLK_TX5336_RNE_AXI_CLK>,
		<&ts_clk TS_CLK_TX5336_RNE_CORE_CLK>, <&ts_clk TS_CLK_TX5336_RNE_CORE_PLL_CLK>,
		<&ts_clk TS_CLK_TX5336_RNE_CORE_PLL0_CLK>;
	clock-names = "rne_ahb_clk", "rne_axi_clk", "rne_core_clk", "rne_core_pll01",
		"rne_core_pll1_d2_clk";

	assigned-clocks = <&ts_clk TS_CLK_TX5336_RNE_CORE_CLK>,
		<&ts_clk TS_CLK_TX5336_RNE_CORE_PLL_CLK>,
		<&ts_clk TS_CLK_TX5336_RNE_CORE_PLL1_D2_CLK>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5336_RNE_CORE_PLL_CLK>,
		<&ts_clk TS_CLK_TX5336_RNE_CORE_PLL1_D2_CLK>,
		<&ts_clk TS_CLK_TX5336_PLL1_D2>;
	assigned-clock-rates = <0>, <0>, <615000000>;
};

