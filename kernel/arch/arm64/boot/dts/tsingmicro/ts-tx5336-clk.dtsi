#include <dt-bindings/clock/ts-tx5336-clk.h>
/ {
	misc_clk: misc_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/*clock-frequency = <5000000>;*/
		clock-frequency = <7379713>;
	};

	osc24m: osc24m_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-accuracy = <100>;
	};

	osc32k: osc32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-accuracy = <100>;
	};


	ts_clk: tx536-clock-controller {
		compatible = "ts,ts-common-clk";
		reg = <0x0 0xF038A000 0x0 0x1000>;
		reg-io-width = <4>;
		#clock-cells = <1>;
		clocks = <&osc24m>;

		/* clk provider assign clocks that has no mounting at any device */
		assigned-clocks = <&ts_clk TS_CLK_TX5336_CPU_CCLK>,
								<&ts_clk TS_CLK_TX5336_PLL_MUX>,
								<&ts_clk TS_CLK_TX5336_CPU_ACLK>;
		assigned-clock-parents = <&ts_clk TS_CLK_TX5336_PLL_MUX>,
									<&ts_clk TS_CLK_TX5336_CPU_PLL1_CCLK>,
									<0>;
		assigned-clock-rates = <1000000000>,
									<1000000000>,
									<500000000>;
	};
};

&pwm {
	clocks = <&ts_clk TS_CLK_TX5336_PWM_APB_CLK>;
};

