	clocks = <&ts_clk TS_CLK_TX5215_MIPI_RX1_PCLK>,
		   <&ts_clk TS_CLK_TX5215_MIPI_RX1_PIXCLK>;

	clock-names = "rx1_pclk", "rx1_pixclk";
};

