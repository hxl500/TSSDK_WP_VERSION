#include <dt-bindings/clock/ts-tx5215-clk.h>
/ {
	misc_clk: misc_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <9216000>;
	};

	sata_clk: sata_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <75000000>;
	};

	clk100: clk100 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};

	clk600: clk600 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <600000000>;
	};

	timer_low_clk: timer_low_clk {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <1200000>;
	};

	timer_clk: timer_clk {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <100000000>;
	};

	timer_pclk: timer_pclk {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <100000000>;
	};

	usi_clk: usi_clk {
		compatible = "fixed-clock";
		#clock-cells = <0x0>;
		clock-frequency = <20000000>;
	};

	mclk: mclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	pclk: pclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <20000000>;
	};

	osc24m: osc24m_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-accuracy = <100>;
	};

	osc32k: osc32k_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-accuracy = <100>;
	};

	ts_clk: tx5215-clock-controller {
		compatible = "ts,ts-common-clk";
		reg = <0xF1004000 0x1000>;
		reg-io-width = <4>;
		#clock-cells = <1>;
		clocks = <&osc24m>;
	};
};

&ts_codec {
	clocks = <&ts_clk TS_CLK_TX5215_AUD_CODEC_HCLK>,
			<&ts_clk TS_CLK_TX5215_DIV0_CODEC_DAC_CCLK>,
			<&ts_clk TS_CLK_TX5215_DIV1_CODEC_DAC_CCLK>,
			<&ts_clk TS_CLK_TX5215_AUD_DAC_PBCLK_DIV>,
			<&ts_clk TS_CLK_TX5215_DIV0_CODEC_ADC_CCLK>,
			<&ts_clk TS_CLK_TX5215_DIV1_CODEC_ADC_CCLK>,
			<&ts_clk TS_CLK_TX5215_AUD_DIV_ED_TMR_SRTB>;
	clock-names = "aud_codec_ahb_clk","dac_cclk_div0", "dac_cclk","dac_pbclk",
				 "adc_cclk_div0","adc_cclk","ed_tmr_strb";
};

&vpe {
	clocks = <&ts_clk TS_CLK_TX5215_VPE_HCLK>,
		   <&ts_clk TS_CLK_TX5215_VPE_ACLK>,
		   <&ts_clk TS_CLK_TX5215_VPE_CCLK>;
	clock-names = "vpe_hclk","vpe_aclk", "vpe_cclk";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_VPE_CCLK>;
	assigned-clock-rates = <500000000>;
};

&uart0 {
	clocks = <&misc_clk &misc_clk>;
};

&uart1 {
	clock-names = "baudclk", "apb_pclk";
	clocks = <&ts_clk TS_CLK_TX5215_UART1_SCLK>,
			 <&ts_clk TS_CLK_TX5215_UART1_PCLK>;
	assigned-clocks = <&ts_clk TS_CLK_TX5215_UART1_SCLK>;
	assigned-clock-rates = <48000000>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5215_PLL1_D4>;
};

&uart2 {
	clock-names = "baudclk", "apb_pclk";
	clocks = <&ts_clk TS_CLK_TX5215_UART2_SCLK>,
			 <&ts_clk TS_CLK_TX5215_UART2_PCLK>;
	assigned-clocks = <&ts_clk TS_CLK_TX5215_UART2_SCLK>;
	assigned-clock-rates = <48000000>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5215_PLL1_D4>;
};

&usart0 {
	clocks = <&usi_clk>;
	clocks = <&ts_clk TS_CLK_TX5215_USI0_PCLK>;
};

&usart1 {
	clock-names = "usi_clk";
	clocks = <&ts_clk TS_CLK_TX5215_USI1_PCLK>;
};

&ui2c0 {
	clock-names = "usi_clk";
	clocks = <&ts_clk TS_CLK_TX5215_USI0_PCLK>;
};

&ui2c1 {
	clock-names = "usi_clk";
	clocks = <&ts_clk TS_CLK_TX5215_USI1_PCLK>;
};

&uspi0 {
	clocks = <&ts_clk TS_CLK_TX5215_USI0_PCLK>;
	clock-names = "usi_clk";
};

&gpio0 {
	clocks = <&ts_clk TS_CLK_TX5215_GPIO_A_PCLK>;
	clock-names = "pclk";
};

&gpio1 {
	clocks = <&ts_clk TS_CLK_TX5215_GPIO_B_PCLK>;
	clock-names = "pclk";
};

&i2c0 {
	clocks = <&ts_clk TS_CLK_TX5215_I2C0_ICCLK>,
			<&ts_clk TS_CLK_TX5215_I2C0_PCLK>;
	clock-names = "icclk", "pclk";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_I2C0_ICCLK>;
	assigned-clock-rates = <50000000>;
};

&i2c1 {
	clocks = <&ts_clk TS_CLK_TX5215_I2C1_ICCLK>,
			<&ts_clk TS_CLK_TX5215_I2C1_PCLK>;
	clock-names = "icclk", "pclk";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_I2C1_ICCLK>;
	assigned-clock-rates = <50000000>;
};

&i2c2 {
	clocks = <&ts_clk TS_CLK_TX5215_I2C2_ICCLK>,
			<&ts_clk TS_CLK_TX5215_I2C2_PCLK>;
	clock-names = "icclk", "pclk";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_I2C2_ICCLK>;
