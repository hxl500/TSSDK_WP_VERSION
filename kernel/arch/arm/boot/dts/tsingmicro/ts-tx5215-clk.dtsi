};

&motor_hor {
	clocks = <&ts_clk TS_CLK_TX5215_TMR_PCLK>, <&ts_clk TS_CLK_TX5215_TMR_T3CLK>;
	clock-names = "pclk", "timer";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_TMR_T3CLK>;
	assigned-clock-rates = <12000000>;
};

&motor_ver {
	clocks = <&ts_clk TS_CLK_TX5215_TMR_PCLK>, <&ts_clk TS_CLK_TX5215_TMR_T4CLK>;
	clock-names = "pclk", "timer";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_TMR_T4CLK>;
	assigned-clock-rates = <12000000>;
};

&sdhci0 {
	clocks = <&ts_clk TS_CLK_TX5215_SD0_CCLK_DIV2>, <&ts_clk TS_CLK_TX5215_SD0_CCLK_SMPL>, <&ts_clk TS_CLK_TX5215_SD0_CCLK_DRV>, <&ts_clk TS_CLK_TX5215_SDHC0_HCLK>;
	clock-names = "ciu", "siu", "diu", "hiu";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_SD0_CCLK_DIV2>;
	assigned-clock-rates = <100000000>;
	assigned-clocks = <&ts_clk TS_CLK_TX5215_SD0_CCLK_SMPL>, <&ts_clk TS_CLK_TX5215_SD0_CCLK_DRV>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5215_SD0_CCLK_ALIEND>, <&ts_clk TS_CLK_TX5215_SD0_CCLK_ALIEND>;
};

&sdhci1 {
	clocks = <&ts_clk TS_CLK_TX5215_SD1_CCLK_DIV2>, <&ts_clk TS_CLK_TX5215_SD1_CCLK_SMPL>, <&ts_clk TS_CLK_TX5215_SD1_CCLK_DRV>, <&ts_clk TS_CLK_TX5215_SDHC1_HCLK>;
	clock-names = "ciu", "siu", "diu", "hiu";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_SD1_CCLK_DIV2>;
	assigned-clock-rates = <100000000>;
	assigned-clocks = <&ts_clk TS_CLK_TX5215_SD1_CCLK_SMPL>, <&ts_clk TS_CLK_TX5215_SD1_CCLK_DRV>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5215_SD1_CCLK_ALIEND>, <&ts_clk TS_CLK_TX5215_SD1_CCLK_ALIEND>;
};

&dp0 {
	clocks = <&ts_clk TS_CLK_TX5215_NEMADC_HCLK>, <&ts_clk TS_CLK_TX5215_NEMADC_CCLK>;
	clock-names =  "pclk", "cclk";
};

&watchdog0 {
	clocks = <&ts_clk TS_CLK_TX5215_WDT_PCLK>, <&osc32k>;
	clock-names = "pclk", "work_clk";
};

&pwm {
	clocks = <&ts_clk TS_CLK_TX5215_PWM_PCLK>;
	clock-names = "pwm_pclk";
};

&spi0 {
	clocks = <&ts_clk TS_CLK_TX5215_SPI_SSICLK>,
		<&ts_clk TS_CLK_TX5215_SPI_PCLK>;
	clock-names = "ref_clk", "pclk";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_SPI_SSICLK>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5215_PLL1_D3>;
	assigned-clock-rates = <204800000>;	
};

&dvp {
	clocks = <&ts_clk TS_CLK_TX5215_DVP_HCLK>,
		<&ts_clk TS_CLK_TX5215_DVP_ACLK>;
	clock-names = "dvp_hclk", "dvp_aclk";
};

&isp {
	clocks = <&ts_clk TS_CLK_TX5215_ISP_SCLK>,
		   <&ts_clk TS_CLK_TX5215_VI_DDR_ACLK>,
		   <&ts_clk TS_CLK_TX5215_ISP_ACLK>,
		   <&ts_clk TS_CLK_TX5215_VI_CFG_HCLK>,
		   <&ts_clk TS_CLK_TX5215_VPE_ISP_CLK>;
	clock-names = "sclk", "vi_ddr_aclk", "aclk", "vi_hclk", "isp_vpe";

	assigned-clocks = <&ts_clk TS_CLK_TX5215_ISP_SCLK>,
		<&ts_clk TS_CLK_TX5215_VI_DDR_ACLK>;
	assigned-clock-rates = <200000000>, <500000000>;
};
&ts_timer{
	clocks = <&ts_clk TS_CLK_TX5215_TMR_PCLK>, <&ts_clk TS_CLK_TX5215_TMR_T5CLK>,<&ts_clk TS_CLK_TX5215_TMR_T6CLK>;
	clock-names = "tm_pclk", "tm5_mclk","tm5_mclk";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_TMR_T5CLK>,<&ts_clk TS_CLK_TX5215_TMR_T6CLK>;
	assigned-clock-rates = <50000000>,<50000000>;
};
&mipi_rx0 {
	clocks = <&ts_clk TS_CLK_TX5215_MIPI_RX0_PCLK>,
		   <&ts_clk TS_CLK_TX5215_MIPI_RX0_PIXCLK0>,
		   <&ts_clk TS_CLK_TX5215_MIPI_RX0_PIXCLK1>;

	clock-names = "rx0_pclk", "rx0_pixclk0", "rx0_pixclk1";
};

