	clock-names = "pdm_pclk", "pdm_mclk";
};

&cve {
	clocks = <&ts_clk TS_CLK_TX5215_CVE_HCLK>, <&ts_clk TS_CLK_TX5215_CVE_ACLK>, <&ts_clk TS_CLK_TX5215_CVE_CCLK>,<&ts_clk TS_CLK_TX5215_DISP_CFG_HCLK>;
	clock-names = "cve_hclk", "cve_aclk", "cve_cclk", "disp_cfg_hclk";
};

