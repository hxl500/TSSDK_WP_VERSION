	clock-names = "ospi_refclk", "ospi_hclk", "ospi_pclk";
};

&amr {
		clocks = <&ts_clk TS_CLK_TX5215_AMR_HCLK>,
				<&ts_clk TS_CLK_TX5215_AMR_ACLK>,
				<&ts_clk TS_CLK_TX5215_AMR_CCLK>,
				<&ts_clk TS_CLK_TX5215_DISP_CFG_HCLK>;
				clock-names = "amr_hclk","amr_aclk","amr_cclk","disp_cfg_hclk";
};

&usb0 {
	clocks = <&ts_clk TS_CLK_TX5215_USB_PHY_CLK>,<&ts_clk TS_CLK_TX5215_USB2C_HCLK>;
	clock-names = "phy_clk","otg";
	assigned-clocks = <&ts_clk TS_CLK_TX5215_USB_PHY_CLK>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5215_OSC_24M>;  //24M
	//assigned-clock-parents = <&ts_clk TS_CLK_TX5215_PLL0_D40>;  //50M
	phy_clk_sel = <24000000>;//osc24m_pll_50m
};

