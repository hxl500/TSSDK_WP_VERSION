				<&ts_clk TS_CLK_TX5112_AI_ACLK>;
				clock-names = "amr_hclk","amr_aclk","amr_cclk","disp_cfg_hclk";
};

&adc {
	clocks = <&ts_clk TS_CLK_TX5112_ADC_PCLK>;
	clock-names = "adc_pclk";
};

&ocotp {
	clocks = <&ts_clk TS_CLK_TX5112_OTPC_PCLK>;
	clock-names = "otpc_pclk";
};

&vpu_h265 {
	assigned-clocks =	<&ts_clk TS_CLK_TX5112_H265_CCLK>, <&ts_clk TS_CLK_TX5112_VPU_ACLK>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5112_PLL1>;
	assigned-clock-rates = <614400000>, <500000000>;
};

&hx280enc {
	//clocks = <&ts_clk TS_CLK_TX5112_H264_PCLK>, <&ts_clk TS_CLK_TX5112_H264_ACLK>;
	//clock-names = "h264_pclk","h264_aclk";
	clocks = <&ts_clk TS_CLK_TX5112_H264_ACLK>;
	clock-names = "h264_aclk";
};



&rne_dma {
	clocks = <&ts_clk TS_CLK_TX5112_RNE_ACLK>,
			 <&ts_clk TS_CLK_TX5112_RNE_CCLK>,
			 <&ts_clk TS_CLK_TX5112_AI_ACLK>,
			 <&ts_clk TS_CLK_TX5112_RNE_HCLK>;
	clock-names = "rne_aclk", "rne_cclk", "rne_ai_aclk", "rne_hclk";
	assigned-clocks = <&ts_clk TS_CLK_TX5112_RNE_CCLK>,
					<&ts_clk TS_CLK_TX5112_RNE_ACLK>;
	assigned-clock-rates = <614400000>, <400000000>;
	assigned-clock-parents = <&ts_clk TS_CLK_TX5112_PLL1>;
};