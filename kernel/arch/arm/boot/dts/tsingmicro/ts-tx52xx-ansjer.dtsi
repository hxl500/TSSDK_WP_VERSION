#include "ts-tx5215.dtsi"
#include "ts-tx5215-clk.dtsi"
#include "ts-tx5215-reset.dtsi"
#include "ts-tx52xx-ansjer-pinctrl.dtsi"

/ {
	chosen {
		/*bootargs = "console=ttyS0,115200n8 initrd=0xc4000000,4M init=/linuxrc
		 * root=/dev/ram0 rw rootfstype=ext4 rootwait ignore_loglevel earlycon";
		 */
		bootargs = "console=ttyS0,115200n8 earlycon";
		/*bootargs = "console=ttyS0,115200n8 ignore_loglevel";
		 *bootargs = "root=/dev/ram0 rw ramdisk=8192 initrd=0x41000000,8M
		 *console=ttyS0,115200n8 init=/linuxrc";
		 */
		stdout-path = "serial0:115200";
	};

       gpio-keys {
                compatible = "gpio-keys";
                pinctrl-names = "default","default";
               /* pinctrl-0 = <&gpioa7_pinctrl>; */
                pinctrl-0 = <&gpioa21_pinctrl>;
/*
                FACTORY {
                        label = "factory_rst";
                        gpios = <&porta 7 GPIO_ACTIVE_LOW>;
                        linux,code = <0x198>;
                        gpio-key,wakeup;
                        debounce-interval = <10>;
                };
*/
                ONE_KEY_CALL {
                        label = "one_key_call";
                        gpios = <&porta 21 GPIO_ACTIVE_LOW>;
                        linux,code = <0x194>;
                        gpio-key,wakeup;
                        debounce-interval = <10>;
                };
        };



};

&uart0 {
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	// pinctrl-0 = <&uart1_pinctrl>;
	status = "disabled";
};

&uart2 {
	pinctrl-names = "default";
	// pinctrl-0 = <&uart2_pinctrl_0>;
	status = "disabled";
};

&usart0 {
	status = "disabled";
};

&usart1 {
	status = "disabled";
};

&rne_dma {
	status = "okay";
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pinctrl_1>;
	//i2c-sda-hold-time-ns = <600>;

	cam0: imgsensor0@20 {
		compatible = "image,sensor0";
		reg = <0x6c>;

		pinctrl-names = "default", "default";
		pinctrl-0 = <&gpiob8_pinctrl>;
		pinctrl-1 = <&chip_out0_pinctrl>;
		rst-gpios = <&portb 8 GPIO_ACTIVE_HIGH>;

		clocks = <&mclk>;
		clock-names = "mclk";
		mclk-freq = <24000000>;
	};

       cam1: imgsensor1@20 {
                compatible = "image,sensor1";
                reg = <0x20>;

                pinctrl-names = "default", "default";
                pinctrl-0 = <&gpiob11_pinctrl>;
                rst-gpios = <&portb 11 GPIO_ACTIVE_HIGH>;

                clocks = <&mclk>;
                clock-names = "mclk";
                mclk-freq = <24000000>;
        };

	
};

&i2c2 {
	status = "disabled";
	pinctrl-names = "default";
	//pinctrl-0 = <&i2c2_pinctrl_1>;
	//i2c-sda-hold-time-ns = <600>;
	//i2c-sda-falling-time-ns = <600>;
	//i2c-scl-falling-time-ns = <400>;
};

&i2c3 {
	status = "disabled";
};

&ui2c0 {
	status = "disabled";
};

&ui2c1 {
	status = "disabled";
};

/*
&gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&ir_cut_gpio_pinctrl>;
	status = "okay";
};
*/
&dp0 {
	status = "okay";
	port {
		dp0_output: endpoint {
			remote-endpoint = <&hdmi_virt_input>;
		};
	};
};

&hdmi_virt {
	status = "okay";
	ports {
		port {
			#address-cells = <1>;
			#size-cells = <0>;

			hdmi_virt_input: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dp0_output>;
			};
		};
	};
};

&cve {
	status = "okay";
};

&can0 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&can0_pinctrl_0 &can0_pinctrl_1>;
};

&can1 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&can1_pinctrl_0 &can1_pinctrl_1>;
};

&amr {
	status = "okay";
};

&vpu_h265 {
	status = "okay";
};

&hx280enc {
	status = "okay";
};

&qspi {
	status = "okay";
	page-size = <256>;
	block-size = <16>;
	#address-cells = <1>;
	#size-cells = <0>;

#if 1
	nand1:spi-nand@0 {
		status = "okay";
		compatible = "spi-nand";
		reg = <0>; /* CS0 */
		//spi-max-frequency = <40000000>;
		spi-max-frequency = <20000000>;
		page-size = <2048>;
		block-size = <131072>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		cdns,read-delay = <0>;
		cdns,tshsl-ns = <0>;
		cdns,tsd2d-ns = <0>;
		cdns,tchsh-ns = <0>;
		cdns,tslch-ns = <0>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* reserved for future boot direct from NAND flash
			 * (this would use the same layout as the 8MiB NOR flash)
			 */
			partition@0 {
				label = "nand-boot-reserved";
				reg = <0 0x800000>;
			};

			/* recovery / install environment */
			partition@800000 {
				label = "recovery";
				reg = <0x800000 0x2000000>;
			};

			/* ubia (first OpenWrt) - a/b names to prevent confusion with ubi0/1/etc. */
			partition@2800000 {
				label = "ubia";
				reg = <0x2800000 0x3C00000>;
			};
#if 0
			/* ubib (second OpenWrt) */
			partition@6400000 {
				label = "ubib";
				reg = <0x6400000 0x3C00000>;
			};
#endif
		};
	};

#else

	flash0: giga0@0 {
		reg = <0>; /* CS0 */
		cdns,read-delay = <2>;
		cdns,tshsl-ns = <40>;
		cdns,tsd2d-ns = <50>;
		cdns,tchsh-ns = <3>;
		cdns,tslch-ns = <4>;
		spi-max-frequency = <51200000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
#endif
};

&sdhci0 {
	/* qspi and sdhci0 cannot coexist */
	/*status = "okay";*/
	status = "disabled";
	//pinctrl-names = "default";
	//pinctrl-0 = <&emmc0_pinctrl>;
};

&sdhci1 {
	status = "okay";
	max-frequency = <25000000>;
	no-1-8-v;
	bus-width = <4>;
	cap-sd-highspeed;
	pinctrl-names = "default";
	pinctrl-0 = <&mshc1_pinctrl &emmc1_pinctrl &sd_pwr_pinctrl>;
	card-detect-delay = <200>;
	sdpwr-gpios = <&porta 24 GPIO_ACTIVE_HIGH>;
};


&spi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pinctrl &spi_lcd_rs_pinctrl &spi_lcd_rst_pinctrl  &gpiob15_pinctrl>;
	//cs-gpios = <&portb 19 GPIO_ACTIVE_LOW>;
	spi0_lcd: gc9108@0 {
	compatible = "gc9108,spi-lcd";
	spi-max-frequency = <4000000>;
   	rst-gpios = <&portb 24 GPIO_ACTIVE_HIGH>;
	rs-gpios = <&portb 22 GPIO_ACTIVE_HIGH>; 
	bk-gpios = <&portb 15 GPIO_ACTIVE_HIGH>;

	//#address-cells = <1>;
	//#size-cells = <1>;
	reg = <0>;
	};	
	
};

&watchdog0 {
	status = "okay";
};

&pwm {
	status = "okay";
};

&rtc {
	status = "okay";
};

&osr_hash {
	status = "okay";
};

&osr_ske {
	status = "okay";
};

&osr_pke {
	status = "okay";
};

&pinctrl {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&ir0_led_cut_pinctrl>;
};

&hwacc {
	status = "okay";
};

&dwahbdma0 {
	status = "okay";
};

&dwahbdma1 {
	status = "okay";
};

&dw_axi_dmac {
	status = "okay";
};

&motor_hor {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&motor_pinctrl0>;
	motor1-gpios = <&porta 0 GPIO_ACTIVE_HIGH>;
	motor2-gpios = <&porta 8 GPIO_ACTIVE_HIGH>;
	motor3-gpios = <&porta 6 GPIO_ACTIVE_HIGH>;
	motor4-gpios = <&porta 4 GPIO_ACTIVE_HIGH>;
};

&motor_ver {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&motor_pinctrl1>;
	motor1-gpios = <&porta 5 GPIO_ACTIVE_HIGH>;
	motor2-gpios = <&porta 1 GPIO_ACTIVE_HIGH>;
	motor3-gpios = <&porta 3 GPIO_ACTIVE_HIGH>;
	motor4-gpios = <&porta 2 GPIO_ACTIVE_HIGH>;
};

&pdmic {
	pinctrl-names = "default";
	pinctrl-0 = <&pdmic_pinctrl_0>;
	ts,model = "PDMIC @ tsm-tx5215-fpga";
	ts,mic-min-freq = <1024000>;
	ts,mic-max-freq = <3072000>;
	ts,mic-offset = <0x0>;
	status = "disabled";
	dmas = <&dwahbdma1 0x6 1 0>;
	dma-names = "rx";
};

&ts_codec {
	status = "okay";
	ts,model = "ts-codec";
	dmas = <&dwahbdma1 0xe 1 1 &dwahbdma1 0xd 1 0>;
	dma-names = "tx","rx";
	pinctrl-names = "default";
	pinctrl-0 = <&gpioa9_pinctrl>;
	speaker-gpios = <&porta 9 GPIO_ACTIVE_LOW>;
};

&sys {
	status = "okay";
};

&mpp {
	status = "okay";
};

&vpe {
	status = "okay";
};

&usb0 {
	status = "okay";
	//pinctrl-names = "default";
	//pinctrl-0 = <&usb_pinctrl>;
	//drvvbus-gpios  = <&portb 11 GPIO_ACTIVE_HIGH>;
};

&ocotp {
	status = "okay";
};

&adc {
	status = "okay";
