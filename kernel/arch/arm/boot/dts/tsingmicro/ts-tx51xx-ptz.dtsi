#include "ts-tx5112.dtsi"
#include "ts-tx5112-clk.dtsi"
#include "ts-tx5112-reset.dtsi"
#include "ts-tx51xx-ptz-pinctrl.dtsi"

/ {
	chosen {
		/*bootargs = "console=ttyS0,115200n8 initrd=0xc4000000,4M init=/linuxrc
		 * root=/dev/ram0 rw rootfstype=ext4 rootwait ignore_loglevel earlycon";
		 */
		bootargs = "console=ttyS0,115200n8 earlycon";
		/*bootargs = "console=ttyS0,115200n8 ignore_loglevel";
		 *bootargs = "root=/dev/ram0 rw ramdisk=8192 initrd=0x41000000,8M
		 *console=ttyS0,115200n8 init=/linuxrc";
		 */
		stdout-path = "serial0:115200";
	};

	sound {
		status = "disabled";
		compatible = "ts-es8388,tx5112";
		model = "ts-audio-es8388";
		i2s-controller = <&i2s>;
		audio-codec = <&codec>;
		//codec-master;
	};
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default","default";
		pinctrl-0 = <&gpioa1_pinctrl>;
		pinctrl-1 = <&gpioa13_pinctrl>;
		FACTORY {
			label = "factory_rst";
			gpios = <&porta 1 GPIO_ACTIVE_LOW>;
			linux,code = <0x101>;
			gpio-key,wakeup;
			debounce-interval = <10>;
		};

		CMCC_CALL {
			label = "cmcc_call";
			gpios = <&porta 13 GPIO_ACTIVE_LOW>;
			linux,code = <0x102>;
			gpio-key,wakeup;
			debounce-interval = <10>;
		};
	};
};

&systimer0_0 {
	status = "disabled";
};

&uart0 {
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	// pinctrl-0 = <&uart1_pinctrl>;
	status = "disabled";
};

&gpio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&ir_cut_gpio_pinctrl>;
	status = "okay";
};

&gpio1 {
	pinctrl-names = "default";
	// pinctrl-0 = <&gpiob11_pinctrl>;
	status = "okay";
};

&usart0 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&usi0_pinctrl>;
};

#if 0


&usart1 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&usi1_pinctrl>;
};

&smu{
	status = "okay";
};

/*
 *&smmu {
 *	status = "disabled";
 *};
 */
#endif

&rne_dma {
	status = "okay";
};

&uspi0 {
	status = "disabled";
	#address-cells = <0x1>;
	#size-cells = <0x0>;
	pinctrl-names = "default";
	pinctrl-0 = <&usi0_pinctrl &gpioa9_pinctrl>;
	uspics-gpios = <&porta 9 GPIO_ACTIVE_HIGH>;
	uspi0_flash0:w25q64@00 {
		status = "okay";
		compatible = "winbond,w25q64","jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		#address-cells = <1>;
		#size-cells = <1>;
		partition@usi2spi-test0{
			label = "test0";
			reg = <0x0 0x800000>; /* 8MB */
		};

	};
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pinctrl_0>;
	eeprom: eeprom@50 {
		compatible = "atmel,24c32";
		reg = <0x50>;
		pagesize = <32>;
	};

	cam0: imgsensor0@20 {
		compatible = "image,sensor0";
		reg = <0x20>;

		pinctrl-names = "default", "default";
		pinctrl-0 = <&gpioa18_pinctrl>;
		pinctrl-1 = <&chip_out0_pinctrl>;
		rst-gpios = <&porta 18 GPIO_ACTIVE_HIGH>;

		clocks = <&ts_clk TS_CLK_TX5112_CHIP_OCLK_I0>;
		clock-names = "mclk";
		assigned-clocks = <&ts_clk TS_CLK_TX5112_CHIP_OCLK_I0>;
		assigned-clock-rates = <24000000>;
	};
};

&i2s {
	status = "disabled";
	dmas = <&dwahbdma1 0x5 2 1 &dwahbdma1 0x4 1 0>;
	dma-names = "tx", "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_pinctrl_1>;
};

&ui2c0 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&usi0_pinctrl>;
	eeprom1: eeprom1@50 {
		compatible = "atmel,24c32";
		reg = <0x50>;
		pagesize = <32>;
	};
};

#if 0
&ui2c1 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&usi1_pinctrl>;
};


&i2c3 {
	status = "disabled";
};


&dp0 {
	status = "okay";
	port {
		dp0_output: endpoint {
			remote-endpoint = <&hdmi_virt_input>;
		};
	};
};
#endif

&i2c1 {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pinctrl>;

	codec: es8388@11 {
		//ce-gpios = <&porta 15 GPIO_ACTIVE_HIGH>;
		compatible = "everest,es8388";
		clocks = <&misc_clk>;
		reg = <0x11>;
	};

};

&vpu_h265 {
	status = "okay";
};

&hx280enc {
	status = "okay";
};

&qspi {
	status = "okay";
	page-size = <256>;
	block-size = <16>;
	#address-cells = <1>;
	#size-cells = <0>;

#if 0
	nand1:spi-nand@0 {
		status = "okay";
		compatible = "spi-nand";
		reg = <0>; /* CS0 */
		//spi-max-frequency = <77000000>;
		spi-max-frequency = <51000000>;
		//spi-max-frequency = <10000000>;
		page-size = <2048>;
		block-size = <131072>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		cdns,read-delay = <2>;
		cdns,tshsl-ns = <0>;
		cdns,tsd2d-ns = <0>;
		cdns,tchsh-ns = <0>;
		cdns,tslch-ns = <0>;
		nand-ecc-mode = "on-die";
		nand-on-flash-bbt;
		//nand-ecc-strength = <4>;
		//nand-ecc-step-size = <512>;
		//nand-ecc-maximize = <8>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* reserved for future boot direct from NAND flash
			 * (this would use the same layout as the 8MiB NOR flash)
			 */
			partition@0 {
				label = "nand-boot-reserved";
				reg = <0 0x800000>;
			};

			/* recovery / install environment */
			partition@800000 {
				label = "recovery";
				reg = <0x800000 0x2000000>;
			};

			/* ubia (first OpenWrt) - a/b names to prevent confusion with ubi0/1/etc. */
			partition@2800000 {
				label = "ubia";
				reg = <0x2800000 0x3C00000>;
			};
#if 0
			/* ubib (second OpenWrt) */
			partition@6400000 {
				label = "ubib";
				reg = <0x6400000 0x3C00000>;
			};
#endif
		};
	};
#else
	flash0: giga0@0 {
		reg = <0>; /* CS0 */
		compatible = "cdns,qspi-nor";
		cdns,read-delay = <2>;
		cdns,tshsl-ns = <40>;
		cdns,tsd2d-ns = <50>;
		cdns,tchsh-ns = <3>;
		cdns,tslch-ns = <4>;
		spi-max-frequency = <51200000>;
		#address-cells = <1>;
		#size-cells = <1>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
	};
#endif
};

&sdhci1 {
	status = "okay";
	max-frequency = <25000000>;
	no-1-8-v;
	bus-width = <4>;
	cap-sd-highspeed;
	pinctrl-names = "default";
	pinctrl-0 = <&mshc1_pinctrl &emmc1_pinctrl &sd_pwr_pinctrl>;
	card-detect-delay = <200>;
	cd-gpios = <&porta 14 GPIO_ACTIVE_LOW>;
	sdpwr-gpios = <&porta 15 GPIO_ACTIVE_LOW>;
};

&spi0 {
	status = "disabled";
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pinctrl &gpioa30_pinctrl>;
	cs-gpios = <&porta 30 GPIO_ACTIVE_LOW>;
	spi0_flash0: wnbnd0@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <1000000>;
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		partition@spi-test0{
			label = "test0";
			reg = <0x0 0x800000>; /* 8MB */
		};
	};
};

&watchdog0 {
	status = "okay";
};

&pwm {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pinctrl>;
};

&rtc {
	status = "okay";
};

&osr_ske {
	status = "okay";
};

&lp_rtc {
	status = "okay";
};

&pinctrl {
	status = "okay";
};

&hwacc {
	status = "okay";
};

&dwahbdma0 {
	status = "disabled";
};

&dwahbdma1 {
	status = "okay";
};

&dw_axi_dmac {
	status = "okay";
};

&hwacc {
	status = "okay";
};


&motor_hor {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&motor_pinctrl0>;
	motor1-gpios = <&porta 0 GPIO_ACTIVE_HIGH>;
	motor2-gpios = <&porta 2 GPIO_ACTIVE_HIGH>;
	motor3-gpios = <&porta 3 GPIO_ACTIVE_HIGH>;
	motor4-gpios = <&porta 4 GPIO_ACTIVE_HIGH>;
};

&motor_ver {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&motor_pinctrl1>;
	motor1-gpios = <&porta 5 GPIO_ACTIVE_HIGH>;
	motor2-gpios = <&porta 6 GPIO_ACTIVE_HIGH>;
	motor3-gpios = <&porta 7 GPIO_ACTIVE_HIGH>;
	motor4-gpios = <&porta 8 GPIO_ACTIVE_HIGH>;
};


&pdmic {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&pdmic_pinctrl_0>;
	ts,model = "PDMIC @ tsm-tx5215-fpga";
	ts,mic-min-freq = <1024000>;
	ts,mic-max-freq = <3072000>;
	ts,mic-offset = <0x0>;
	dmas = <&dwahbdma1 0x6 1 0>;
	dma-names = "rx";
};

&ts_codec {
	status = "okay";
	ts,model = "ts-codec";
	dmas = <&dwahbdma1 0xe 1 1 &dwahbdma1 0xd 1 0>;
	dma-names = "tx","rx";
	pinctrl-names = "default";
	pinctrl-0 = <&gpioa19_pinctrl>;
	speaker-gpios = <&porta 19 GPIO_ACTIVE_HIGH>;
};

&sys {
	status = "okay";
};

&mpp {
	status = "okay";
};

&mpp_proc {
	status = "okay";
};

&vpe {
	status = "okay";
};

&usb0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&drvvbus_pinctrl>;
	drvvbus-gpios  = <&porta 9 GPIO_ACTIVE_HIGH>;
};

&ocotp {
	status = "okay";
};

&adc {
	status = "okay";
};

&amr {
	status = "okay";
